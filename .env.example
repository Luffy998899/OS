# Copy to .env and fill in. Local dev works with just DATABASE_URL + AUTH_SECRET.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Public base URL used for links inside emails and the WhatsApp webhook URL.
# Leave as localhost for local dev. In GitHub Codespaces / Vercel it is
# auto-detected (the forwarded https://<name>-3000.app.github.dev address), so
# you only need to set this for a custom domain.
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# Extra origins allowed to invoke Server Actions behind a proxy/tunnel
# (comma-separated). Every origin is already accepted via src/proxy.ts, and
# next.config.ts pre-allows localhost/Vercel/Codespaces/Gitpod/ngrok/Cloudflare
# as a second line of defense; add custom domains here only if needed, e.g.:
# ALLOWED_ORIGINS="myapp.example.com,*.mydomain.dev"
ALLOWED_ORIGINS=""

# Optional integrations — the app runs without these (features degrade gracefully).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
RESEND_API_KEY=""
EMAIL_FROM="Auxa <noreply@auxa.local>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
WHATSAPP_VERIFY_TOKEN="auxa-verify"
DEEPGRAM_API_KEY=""
CRON_SECRET="change-me"
