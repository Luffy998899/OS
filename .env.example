# Copy to .env and fill in. Local dev works with just DATABASE_URL + AUTH_SECRET.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with: openssl rand -base64 32"
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# Optional integrations — the app runs without these (features degrade gracefully).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
RESEND_API_KEY=""
EMAIL_FROM="Auxa <noreply@auxa.local>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
WHATSAPP_VERIFY_TOKEN="auxa-verify"
DEEPGRAM_API_KEY=""
CRON_SECRET="change-me"
