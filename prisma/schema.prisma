// Auxa — Work OS CRM
// Dev uses SQLite for zero-setup local testing. The schema avoids enums and scalar
// lists so it ports cleanly to PostgreSQL (switch `provider` to "postgresql" and add
// pgvector for DailyJournal.embedding in production).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// People & access control
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String   @default("[]") // JSON array of permission keys (RBAC)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  avatarUrl    String?
  title        String?
  department   String? // maps to gamified rooms / verticals
  phone        String?   @unique
  status       String    @default("active") // active | suspended | invited
  timezone     String    @default("Asia/Kolkata")
  points       Int       @default(0) // cached leaderboard total (source: PointsLedger)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTasks  Task[]             @relation("TaskAssignee")
  createdTasks   Task[]             @relation("TaskCreator")
  coAssignedTasks TaskCollaborator[]
  editingJobs    VideoJob[]         @relation("VideoEditor")
  approvalsRaised ApprovalRequest[] @relation("ApprovalRaisedBy")
  timetableSlots TimetableSlot[]
  taskComments   TaskComment[]
  shifts         Shift[]
  dayReports     DayReport[]
  timeEntries    TimeEntry[]
  documents      Document[]
  documentShares DocumentShare[]
  pointsLedger   PointsLedger[]
  redemptions    RewardRedemption[]
  notifications  Notification[]
  avatar         AvatarState?
  skills         SkillProgress[]
  managedClients Client[]           @relation("ClientManager")
  journals       DailyJournal[]
  createdInvoices Invoice[]         @relation("InvoiceCreator")
  chatMessages   ChatMessage[]
  chatVoice      ChatVoicePresence[]
}

// ---------------------------------------------------------------------------
// CRM — clients & outreach
// ---------------------------------------------------------------------------

model Client {
  id          String        @id @default(cuid())
  companyName String
  ownerName   String?
  email       String?
  phone       String?
  gstin       String?
  address     String?
  category    String? // New Customer | Active | Enterprise | ...
  status      String        @default("new") // new | active | suspended | churned
  temperature String        @default("cold") // hot | warm | cold (outreach)
  notes       String?
  managerId   String?
  manager     User?         @relation("ClientManager", fields: [managerId], references: [id])
  tasks       Task[]
  outreach    OutreachLog[]
  timeEntries TimeEntry[]
  invoices    Invoice[]
  rooms       Room[] // dedicated office area(s) for this client
  projects    Project[]
  videoJobs   VideoJob[]
  creativeSpaces CreativeSpace[]
  shoots      Shoot[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model OutreachLog {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel        String // call | email | whatsapp | meeting
  outcome        String? // followup | interested | not_interested | closed
  note           String?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Tasks / Missions
// ---------------------------------------------------------------------------

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  vertical        String    @default("roadmap") // website-dev | digital-marketing | roadmap | client-outreach | billing
  status          String    @default("todo") // todo | in_progress | review | done | blocked
  priority        String    @default("medium") // low | medium | high | urgent
  points          Int       @default(10)
  estimateMinutes Int?
  dueAt           DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  source          String    @default("manual") // manual | ai | whatsapp | voice
  aiGenerated     Boolean   @default(false)
  approvalStatus  String    @default("approved") // draft | pending_review | approved | rejected
  aiRationale     String? // why AI routed this to this role/person

  // Bounty board — an unassigned mission anyone eligible can claim off the wall.
  isBounty      Boolean   @default(false)
  bountyBonus   Int       @default(0) // urgency bonus XP, frozen at claim time
  claimedAt     DateTime?
  // Skill tree — which craft the mission trains, and the craft level it asks for.
  skill         String    @default("ops") // design | dev | video | ops
  minSkillLevel Int       @default(0)

  assigneeId  String?
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id])
  clientId    String?
  client      Client? @relation(fields: [clientId], references: [id])
  roomId      String?
  room        Room?   @relation(fields: [roomId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  comments      TaskComment[]
  activities    TaskActivity[]
  timeEntries   TimeEntry[]
  collaborators TaskCollaborator[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Co-assignment: a mission one person owns but a squad works on together.
model TaskCollaborator {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String // created | status_changed | assigned | commented | completed
  meta      String? // JSON
  actorId   String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Attendance, day reports & timesheets
// ---------------------------------------------------------------------------

model Shift {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInAt   DateTime   @default(now())
  checkOutAt  DateTime?
  status      String     @default("active") // active | completed
  checkInNote String?
  report      DayReport?
  createdAt   DateTime   @default(now())
}

model DayReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId     String?  @unique
  shift       Shift?   @relation(fields: [shiftId], references: [id])
  date        String // YYYY-MM-DD (IST)
  summary     String
  blockers    String?
  hoursWorked Float?
  tasksWorked String? // JSON array of task ids
  submittedAt DateTime @default(now())
}

model TimeEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  description     String?
  date            String // YYYY-MM-DD
  startTime       String? // HH:MM
  durationSeconds Int      @default(0)
  invoiceStatus   String   @default("not_invoiced") // invoiced | not_invoiced
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Documents & whiteboards (Miro-like)
// ---------------------------------------------------------------------------

model Document {
  id         String          @id @default(cuid())
  title      String
  type       String          @default("whiteboard") // whiteboard | doc
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility String          @default("private") // private | team | public
  content    String? // JSON snapshot (tldraw store) or rich-doc json
  thumbnail  String?
  shares     DocumentShare[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model DocumentShare {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String   @default("view") // view | edit

  @@unique([documentId, userId])
}

// ---------------------------------------------------------------------------
// Gamified AI workspace — rooms, avatars, points & rewards
// ---------------------------------------------------------------------------

model Room {
  id          String        @id @default(cuid())
  key         String        @unique // developer | creative | managing-heads | client:<id> ...
  name        String
  department  String?
  description String?
  kind        String        @default("department") // department | client
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  capacity    Int           @default(12)
  posX        Int           @default(0) // layout position on the office map grid
  posY        Int           @default(0)
  tasks       Task[]
  avatars     AvatarState[]
  createdAt   DateTime      @default(now())
}

model AvatarState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId String?
  room   Room?  @relation(fields: [roomId], references: [id])
  x      Float  @default(0)
  y      Float  @default(0)
  // Altitude (block Y of the feet) — the voxel campus has real floors to stand on.
  alt    Float  @default(0)
  // Heading in radians — first person needs to know which way someone is looking.
  facing Float  @default(0)
  status String @default("online") // online | away | busy
  // Claimed slot in the crew roster (see lib/characters), unique per person.
  characterId String?  @unique
  updatedAt   DateTime @updatedAt
}

// Per-craft XP. Lifetime `User.points` still drives the leaderboard; this is the
// same XP split by craft so it can gate which missions someone is eligible for.
model SkillProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     String // design | dev | video | ops
  xp        Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, skill])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  taskId    String?
  createdAt DateTime @default(now())
}

model Reward {
  id          String             @id @default(cuid())
  name        String
  description String?
  costPoints  Int
  active      Boolean            @default(true)
  redemptions RewardRedemption[]
  createdAt   DateTime           @default(now())
}

model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  status      String   @default("pending") // pending | fulfilled | rejected
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// AI layer & integrations
// ---------------------------------------------------------------------------

model AiCheckin {
  id             String   @id @default(cuid())
  summary        String
  importantTasks String? // JSON
  createdAt      DateTime @default(now())
}

model DailyJournal {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  date      String // YYYY-MM-DD
  content   String
  embedding String? // JSON float array (pgvector column in production)
  createdAt DateTime @default(now())
}

model WhatsAppMessage {
  id           String   @id @default(cuid())
  fromPhone    String
  body         String
  direction    String   @default("inbound") // inbound | outbound
  status       String   @default("received") // received | parsed | approved | rejected
  parsedTaskId String?
  meta         String? // JSON
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // task_assigned | report_reminder | approval | reward | system
  title     String
  body      String?
  read      Boolean  @default(false)
  meta      String? // JSON
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Campus rooms — developer city, video bay, conference, outreach, creative,
// shoot planning and the timetable. Each model backs one themed room.
// ---------------------------------------------------------------------------

// A floor in the developer city. buildingKey decides which structure it lives
// in: "pipeline" (in-progress tower), "complete" (finished tower, 10 floors,
// AI-rearranged by niche), or "tools" (the internal-tools bungalow).
model Project {
  id          String    @id @default(cuid())
  name        String
  buildingKey String    @default("pipeline") // pipeline | complete | tools
  floor       Int       @default(1)
  niche       String?
  status      String    @default("active") // active | complete | archived
  deadline    DateTime?
  repoUrl     String?
  siteUrl     String?
  auditStatus String    @default("unaudited") // unaudited | pass | warn | fail
  auditNote   String?
  // Public link a client uses to drop task requests straight onto the floor.
  shareToken  String    @unique @default(cuid())
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  // The floor's pinned data board: address, contacts, gmail, credentials refs…
  dataBoard   String    @default("[]") // JSON [{label, value}]
  toolDesc    String? // for bungalow entries
  tasks       Task[]
  requests    ClientRequest[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// What a client typed into their floor's share page. Converting one creates a
// real (pending-review) task on the floor.
model ClientRequest {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    String
  body      String
  reply     String? // agent/AI acknowledgement shown back on the share page
  status    String   @default("pending") // pending | converted | dismissed
  taskId    String?
  createdAt DateTime @default(now())
}

// The video bay queue. One job is "editing" at a time per editor; the rest wait
// on the whiteboard in delivery order.
model VideoJob {
  id          String    @id @default(cuid())
  title       String
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  script      String?
  status      String    @default("queued") // queued | editing | delivered
  priority    String    @default("medium") // low | medium | high | urgent
  deliverBy   DateTime?
  position    Int       @default(0)
  editorId    String?
  editor      User?     @relation("VideoEditor", fields: [editorId], references: [id])
  startedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Conference hall feed: urgent meetings, disclosures, incentives and the weekly
// do's & don'ts feedback round.
model Announcement {
  id          String    @id @default(cuid())
  kind        String    @default("disclosure") // urgent_meeting | disclosure | incentive | feedback
  title       String
  body        String?
  meetingAt   DateTime?
  pinned      Boolean   @default(false)
  createdById String
  acks        AnnouncementAck[]
  createdAt   DateTime  @default(now())
}

model AnnouncementAck {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId])
}

// Managing-heads desk: leave applications, task approvals, any query.
model ApprovalRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("ApprovalRaisedBy", fields: [userId], references: [id], onDelete: Cascade)
  kind         String    @default("query") // leave | approval | query
  title        String
  detail       String?
  fromDate     String? // YYYY-MM-DD, leave only
  toDate       String?
  status       String    @default("pending") // pending | approved | rejected
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
}

// Outreach room: the pushed lead list, one sector assigned per agent per day.
model OutreachTarget {
  id           String   @id @default(cuid())
  sector       String // nearby location / zone name
  name         String
  phone        String?
  niche        String?
  notes        String?
  status       String   @default("pending") // pending | contacted | hot | converted | dropped
  assignedToId String?
  assignedDate String? // YYYY-MM-DD
  order        Int      @default(0) // AI day-plan ordering
  createdAt    DateTime @default(now())
}

// OTP a hot lead confirms on the spot; verifying auto-fills them into the CRM.
model LeadOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  targetId  String?
  clientId  String? // set once verified → the created CRM client
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// One creative space per client (plus one internal): brand kit pinned, the
// infinite board, references, scripts, timeline and competitor research.
model CreativeSpace {
  id              String   @id @default(cuid())
  key             String   @unique // client:<clientId> | internal
  name            String
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  boardDocId      String? // whiteboard Document for the infinite board
  brandKit        String   @default("{}") // JSON {colors:[],fonts:[],links:[]}
  competitorNotes String?
  items           CreativeItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CreativeItem {
  id          String        @id @default(cuid())
  spaceId     String
  space       CreativeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  kind        String // reference | reel | note | script | timeline
  title       String
  url         String?
  content     String?
  monthKey    String? // YYYY-MM, timeline entries
  pinned      Boolean       @default(false)
  createdById String?
  createdAt   DateTime      @default(now())
}

// Shoot room: everything planned in front of a camera this day / week.
model Shoot {
  id        String   @id @default(cuid())
  title     String
  date      String // YYYY-MM-DD
  timeNote  String? // "10:30 – 13:00"
  location  String   @default("indoor") // indoor | outdoor
  scope     String   @default("internal") // client | internal
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  priority  String   @default("medium")
  status    String   @default("planned") // planned | done | cancelled
  notes     String?
  createdAt DateTime @default(now())
}

// School-bell timetable: AI splits everyone's day into blocks; the bell rings
// on every block change and after lunch the team logs back in.
model TimetableSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  startMin  Int // minutes from midnight
  endMin    Int
  label     String
  kind      String   @default("work") // work | planning | lunch | scripting | followup | journal | posting | outreach
  clientId  String?
  source    String   @default("ai") // ai | manual
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Post-lunch re-login + bell acknowledgements, so tracking has no gaps.
model TimetableLog {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  type      String // back_from_lunch | bell_ack
  at        DateTime @default(now())

  @@unique([userId, date, type])
}

// ---------------------------------------------------------------------------
// Billing & finance
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  hsnSac      String?
  basePrice   Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String?
  amount      Float
  notes       String?
  date        String // YYYY-MM-DD
  createdById String?
  createdAt   DateTime @default(now())
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique // INV/2026-27/021
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id])
  // Bill-to snapshot (kept even if the client record changes later)
  billToName    String
  billToEmail   String?
  billToPhone   String?
  billToGstin   String?
  billToAddress String?
  invoiceDate  String
  dueDate      String?
  paymentTerms String        @default("net_30") // due_on_receipt | net_15 | net_30 | net_45
  poNumber     String?
  taxType      String        @default("igst") // igst | cgst_sgst | none
  taxRate      Float         @default(18)
  discount     Float         @default(0)
  subtotal     Float         @default(0)
  taxAmount    Float         @default(0)
  total        Float         @default(0)
  status       String        @default("draft") // draft | sent | paid | overdue | cancelled
  notes        String?
  items        InvoiceItem[]
  createdById  String
  createdBy    User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  sentAt       DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  qty         Float   @default(1)
  rate        Float   @default(0)
  amount      Float   @default(0)
  position    Int     @default(0)
}

// ---------------------------------------------------------------------------
// Team chat — spaces, channels and messages
// ---------------------------------------------------------------------------

// A space the team talks in: the agency itself, the client-facing side, etc.
// Channels hang off it the way Slack/Discord splits a workspace into rooms.
model ChatServer {
  id          String        @id @default(cuid())
  key         String        @unique // auxa-hq | clients
  name        String
  description String?
  sortOrder   Int           @default(0)
  channels    ChatChannel[]
  createdAt   DateTime      @default(now())
}

model ChatChannel {
  id        String        @id @default(cuid())
  serverId  String
  server    ChatServer    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  key       String // general | announcements | dev ...
  name      String
  topic     String?
  kind      String        @default("text") // text | voice
  sortOrder Int           @default(0)
  messages  ChatMessage[]
  reads     ChatRead[]
  voice     ChatVoicePresence[]
  signals   ChatVoiceSignal[]
  createdAt DateTime      @default(now())

  @@unique([serverId, key])
}

model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([channelId, createdAt])
}

// How far someone has read a channel — the difference between this and the
// channel's newest message is the unread badge.
model ChatRead {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime

  @@unique([channelId, userId])
  @@index([userId])
}

// Who is sitting in a voice channel right now. Clients heartbeat while
// connected; a row that stops being touched goes stale and is swept, so a
// closed tab never leaves a ghost in the channel.
model ChatVoicePresence {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  muted     Boolean     @default(false)
  deafened  Boolean     @default(false)
  joinedAt  DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([channelId, userId])
  @@index([channelId, updatedAt])
}

// WebRTC handshake traffic between two people in a voice channel. Rows are
// consumed (deleted) by the recipient's next poll — this is a mailbox, not a
// log.
model ChatVoiceSignal {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fromUserId String
  toUserId   String
  kind       String // offer | answer | ice
  payload    String
  createdAt  DateTime    @default(now())

  @@index([toUserId, channelId, createdAt])
}
